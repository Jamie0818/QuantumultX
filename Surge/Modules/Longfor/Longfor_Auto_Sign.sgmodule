#!name=龙湖天街自动签到
#!desc=自动获取当前账号的签到凭证，每天 09:18 签到；遇到滑块或 Token 失效时通知手动刷新。不上传凭证，不破解验证码。
#!author=Codex 定制
#!category=签到
#!system=ios
#!date=2026-10-25
#!homepage=https://github.com/Jamie0818/QuantumultX/tree/master/Surge/Modules/Longfor

[Script]
龙湖天街凭证获取 = type=http-request, pattern=^https:\/\/gw2c-hw-open\.longfor\.com\/lmarketing-task-api-mvc-prod\/openapi\/task\/v1\/signature\/clock(?:\?|$), requires-body=true, max-size=16384, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Longfor/longfor_sign.js, timeout=10
龙湖天街每日签到 = type=cron, cronexp="18 9 * * *", wake-system=true, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Longfor/longfor_sign.js, timeout=25

[MITM]
hostname = %APPEND% gw2c-hw-open.longfor.com
