#!name=龙湖天街自动签到
#!desc=保存用户本人发起的龙湖签到请求并每天 09:18 原样重放；敏感请求头与请求体仅保存在本机 Surge。不上传凭证，不破解验证码。
#!author=Codex 定制
#!category=签到
#!system=ios
#!date=2026-10-25
#!version=1.4.0
#!homepage=https://github.com/Jamie0818/QuantumultX/tree/master/Surge/Modules/Longfor

[General]
force-http-engine-hosts = %APPEND% gw2c-hw-open.longfor.com:443, longzhu.longfor.com:443

[Rule]
AND,((PROTOCOL,UDP),(DOMAIN-SUFFIX,longfor.com)),REJECT

[Script]
龙湖登录凭证补充 = type=http-response, pattern=^https:\/\/longzhu\.longfor\.com\/proxy\/lmember-auth-api-prod-open\/api\/auth\/v1\/key2token(?:\?|$), requires-body=true, max-size=65536, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Longfor/longfor_sign.js?v=1.4.0, timeout=10
龙湖签到请求保存 = type=http-request, pattern=^https:\/\/gw2c-hw-open\.longfor\.com\/lmarketing-task-api-mvc-prod\/openapi\/task\/v1\/signature\/clock(?:\?|$), requires-body=true, max-size=65536, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Longfor/longfor_sign.js?v=1.4.0, timeout=10
龙湖天街每日签到 = type=cron, cronexp="18 9 * * *", wake-system=true, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Longfor/longfor_sign.js?v=1.4.0, timeout=25

[MITM]
hostname = %APPEND% gw2c-hw-open.longfor.com, longzhu.longfor.com
