#!name=京东京豆签到（旧版候选·待测试）
#!desc=NobyDa 2021 多合一签到；接口可能失效，包含其他京东任务，仅供隔离测试。
#!system=ios
#!category=签到

[Script]
京东_获取Cookie_待测试 = type=http-request, pattern=^https:\/\/(api\.m|me-api|ms\.jr)\.jd\.com\/(client\.action\?functionId=signBean|user_new\/info\/GetJDUserInfoUnion\?|gw\/generic\/hy\/h5\/m\/appSign\?), requires-body=true, script-path=https://raw.githubusercontent.com/NobyDa/Script/master/JD-DailyBonus/JD_DailyBonus.js, timeout=30
京东_旧版自动签到_待测试 = type=cron, cronexp="5 0 * * *", wake-system=true, timeout=120, script-path=https://raw.githubusercontent.com/NobyDa/Script/master/JD-DailyBonus/JD_DailyBonus.js

[MITM]
hostname = %APPEND% api.m.jd.com, me-api.jd.com, ms.jr.jd.com
