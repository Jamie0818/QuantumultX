#!name=建行生活签到（候选·待测试）
#!desc=FoKit 2024 签到脚本，需先在 App 手动签到抓取数据；涉及用户资格、券领取设置。
#!system=ios
#!category=签到

[Script]
建行生活_获取签到数据 = type=http-request, pattern=^https:\/\/yunbusiness\.ccb\.com\/(clp_coupon|clp_service)\/txCtrl\?txcode=(A3341A038|autoLogin), requires-body=true, script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/jhsh_checkIn.js, timeout=30
建行生活_每日签到_待测试 = type=cron, cronexp="17 7 * * *", wake-system=true, timeout=60, script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/jhsh_checkIn.js

[MITM]
hostname = %APPEND% yunbusiness.ccb.com
