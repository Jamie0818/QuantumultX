#!name=霸王茶姬签到凭证捕获（不开定时）
#!desc=仅获取签到 Token 和请求 Body，不自动签到。原旧版签到脚本有硬编码个人信息，不建议直接运行。
#!system=ios
#!category=签到

[Script]
霸王茶姬_获取签到凭证 = type=http-request, pattern=^https?:\/\/webapi\.qmai\.cn\/web\/catering\/integral\/sign\/signIn, requires-body=true, script-path=https://raw.githubusercontent.com/jivei/Surge/main/js/bwcj_token.js, timeout=20

[MITM]
hostname = %APPEND% webapi.qmai.cn
