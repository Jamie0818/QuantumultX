#!name=亚朵签到凭证捕获（不开定时）
#!desc=仅获取签到凭证，不自动签到；旧版签到脚本的定时模式包含抽奖任务。
#!system=ios
#!category=签到

[Script]
亚朵_获取签到凭证 = type=http-request, pattern=^https:\/\/miniapp\.yaduo\.com\/atourlife\/signIn\/signIn.+, script-path=https://raw.githubusercontent.com/jivei/Surge/main/js/atour.js, timeout=30

[MITM]
hostname = %APPEND% miniapp.yaduo.com
