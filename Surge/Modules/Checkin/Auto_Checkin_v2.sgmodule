#!name=签到中心 v2（自动+失败提醒）
#!desc=用新签到模块替换旧候选模块；只抓指定接口，定时自动签到，明确失败通知；保留原龙湖。
#!author=ChatGPT 定制
#!category=签到
#!system=ios
#!version=2.0
#!homepage=https://github.com/Jamie0818/QuantumultX/tree/master/Surge/Modules/Checkin

[Script]
签到中心_京东抓取 = type=http-request, pattern=^https:\/\/(?:api\.m|me-api)\.jd\.com\/(?:client\.action\?functionId=signBean|user_new\/info\/GetJDUserInfoUnion\?), script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_v2.js, argument=capture:jd, timeout=15
签到中心_京豆自动 = type=cron, cronexp="9 8 * * *", wake-system=true, timeout=35, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_v2.js, argument=sign:jd
签到中心_茶姬抓取 = type=http-request, pattern=^https:\/\/webapi\.qmai\.cn\/web\/catering\/integral\/sign\/signIn(?:\?|$), requires-body=true, max-size=65536, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_v2.js, argument=capture:chagee, timeout=15
签到中心_茶姬自动 = type=cron, cronexp="13 8 * * *", wake-system=true, timeout=35, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_v2.js, argument=sign:chagee
签到中心_亚朵抓取 = type=http-request, pattern=^https:\/\/miniapp\.yaduo\.com\/atourlife\/signIn\/signIn.+, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_v2.js, argument=capture:atour, timeout=15
签到中心_亚朵自动 = type=cron, cronexp="21 8 * * *", wake-system=true, timeout=35, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_v2.js, argument=sign:atour
签到中心_华住抓取 = type=http-request, pattern=^https:\/\/hweb-personalcenter\.huazhu\.com\/login\/autoLogin$, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_v2.js, argument=capture:huazhu, timeout=15
签到中心_华住自动 = type=cron, cronexp="25 8 * * *", wake-system=true, timeout=35, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_v2.js, argument=sign:huazhu
签到中心_B站抓取 = type=http-request, pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/fingerprint\?, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_v2.js, argument=capture:bili, timeout=15
签到中心_建行抓取 = type=http-request, pattern=^https:\/\/yunbusiness\.ccb\.com\/(?:clp_coupon|clp_service)\/txCtrl\?txcode=(?:A3341A038|autoLogin), requires-body=true, max-size=131072, script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/jhsh_checkIn.js, timeout=20
签到中心_建行自动 = type=cron, cronexp="17 8 * * *", wake-system=true, timeout=120, script-path=https://raw.githubusercontent.com/FoKit/Scripts/main/scripts/jhsh_checkIn.js

签到中心_漏执行提醒 = type=cron, cronexp="3 11 * * *", wake-system=true, timeout=10, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_Watchdog_v2.js


签到中心_结果面板脚本 = type=generic, timeout=10, script-path=https://raw.githubusercontent.com/Jamie0818/QuantumultX/master/Surge/Modules/Checkin/Auto_Checkin_Dashboard_v2.js

[Panel]
每日签到结果 = title="每日自动签到", content="点击刷新查看今天的自动签到执行结果", style=info, script-name=签到中心_结果面板脚本, update-interval=120

[MITM]
hostname = %APPEND% api.m.jd.com, me-api.jd.com, webapi.qmai.cn, miniapp.yaduo.com, hweb-personalcenter.huazhu.com, app.bilibili.com, yunbusiness.ccb.com
